---
interface Props {
  current: number;
  last: number;
}

const { current, last } = Astro.props;
const pages = Array.from({ length: Math.max(last, 1) }, (_, index) => index + 1);

function href(page: number): string {
  return page <= 1 ? "/blog/" : `/blog/${page}/`;
}
---

<nav class="pager" aria-label="글 목록 페이지">
  {
    current > 1 ? (
      <a href={href(current - 1)}>이전</a>
    ) : (
      <span class="is-off">이전</span>
    )
  }
  {
    pages.map((page) =>
      page === current ? (
        <span aria-current="page">{page}</span>
      ) : (
        <a href={href(page)}>{page}</a>
      ),
    )
  }
  {
    current < last ? (
      <a href={href(current + 1)}>다음</a>
    ) : (
      <span class="is-off">다음</span>
    )
  }
</nav>
