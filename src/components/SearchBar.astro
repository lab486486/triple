---
import { getAreasByCity, getCities } from "../lib/content";

interface Props {
  layout?: "panel" | "page";
}

const { layout = "panel" } = Astro.props;
const cities = await getCities();
const grouped = await Promise.all(
  cities.map(async (city) => ({
    city,
    areas: await getAreasByCity(city.id),
  })),
);

const areaMap = Object.fromEntries(
  grouped.map(({ city, areas }) => [
    city.id,
    areas.map((area) => ({
      id: `${city.id}/${area.data.slug}`,
      name: area.data.nameKo,
    })),
  ]),
);

const layouts = [
  { value: "", label: "전체" },
  { value: "apartment", label: "더블+싱글" },
  { value: "triple_bed", label: "싱글X3" },
  { value: "futon_3", label: "다다미" },
  { value: "twin_extra", label: "엑스트라베드" },
];
---

<form
  class:list={["search-card", "search-card-stack", layout === "page" && "search-card-page"]}
  action="/search/"
  method="get"
  data-search-form
  data-areas={JSON.stringify(areaMap)}
>
  <input type="hidden" name="region" value="" />
  <input type="hidden" name="layout" value="" />

  <div class="search-group">
    <span>여행 지역</span>
    <div class="choice-row" data-group="city">
      <button class="choice is-on" type="button" data-value="" aria-pressed="true">전체</button>
      {
        grouped.map(({ city }) => (
          <button class="choice" type="button" data-value={city.id}>
            {city.data.nameKo}
          </button>
        ))
      }
    </div>
    <div class="choice-row" data-group="area" hidden></div>
  </div>

  <div class="search-group">
    <span>침대 구성</span>
    <div class="choice-row" data-group="layout">
      {
        layouts.map((item, index) => (
          <button
            class:list={["choice", index === 0 && "is-on"]}
            type="button"
            data-value={item.value}
            aria-pressed={index === 0 ? "true" : "false"}
          >
            {item.label}
          </button>
        ))
      }
    </div>
  </div>

  <button class="search-submit" type="submit">숙소 찾기</button>
</form>

<script>
  function markOn(row: Element, value: string) {
    row.querySelectorAll<HTMLButtonElement>(".choice").forEach((button) => {
      const on = (button.dataset.value ?? "") === value;
      button.classList.toggle("is-on", on);
      button.setAttribute("aria-pressed", String(on));
    });
  }

  document.querySelectorAll<HTMLFormElement>("[data-search-form]").forEach((form) => {
    const areaMap = form.dataset.areas
      ? (JSON.parse(form.dataset.areas) as Record<
          string,
          { id: string; name: string }[]
        >)
      : {};

    const fields = {
      region: form.querySelector<HTMLInputElement>('[name="region"]')!,
      layout: form.querySelector<HTMLInputElement>('[name="layout"]')!,
    };

    const cityRow = form.querySelector("[data-group='city']")!;
    const areaRow = form.querySelector<HTMLElement>("[data-group='area']")!;
    const layoutRow = form.querySelector("[data-group='layout']")!;
    const params = new URLSearchParams(window.location.search);

    function renderAreas(cityId: string, selected = "") {
      areaRow.replaceChildren();
      const areas = areaMap[cityId] ?? [];
      if (!cityId || areas.length === 0) {
        areaRow.hidden = true;
        return;
      }

      const all = document.createElement("button");
      all.type = "button";
      all.className = `choice${selected ? "" : " is-on"}`;
      all.dataset.value = cityId;
      all.setAttribute("aria-pressed", selected ? "false" : "true");
      all.textContent = "도시 전체";
      areaRow.append(all);

      for (const area of areas) {
        const button = document.createElement("button");
        button.type = "button";
        button.className = `choice${selected === area.id ? " is-on" : ""}`;
        button.dataset.value = area.id;
        button.setAttribute("aria-pressed", String(selected === area.id));
        button.textContent = area.name;
        areaRow.append(button);
      }
      areaRow.hidden = false;
    }

    const region = params.get("region") ?? "";
    const [cityId = "", areaSlug = ""] = region.split("/");
    fields.region.value = region;
    fields.layout.value = params.get("layout") ?? "";

    markOn(cityRow, cityId);
    markOn(layoutRow, fields.layout.value);
    renderAreas(cityId, areaSlug ? region : "");

    cityRow.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>(".choice");
      if (!button) return;
      const value = button.dataset.value ?? "";
      fields.region.value = value;
      markOn(cityRow, value);
      renderAreas(value);
    });

    areaRow.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>(".choice");
      if (!button) return;
      const value = button.dataset.value ?? "";
      fields.region.value = value;
      markOn(areaRow, value);
    });

    layoutRow.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>(".choice");
      if (!button) return;
      const value = button.dataset.value ?? "";
      fields.layout.value = value;
      markOn(layoutRow, value);
    });

    form.addEventListener("submit", () => {
      Object.values(fields).forEach((input) => {
        input.disabled = !input.value;
      });
    });
  });
</script>
