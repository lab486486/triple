---
import JapanMap from "./JapanMap.astro";

interface Props {
  layout?: "panel" | "page";
}

const { layout = "panel" } = Astro.props;
---

<div class:list={["search-card", layout === "page" && "search-card-page"]}>
  <div class="japan-map">
    <h2 class="map-heading">지도에서 3인실 찾기</h2>
    <JapanMap />
    <p class="map-note" data-map-note hidden></p>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLAnchorElement>(".map-city").forEach((pin) => {
    pin.addEventListener("click", (event) => {
      if (pin.dataset.ready === "true") return;
      event.preventDefault();
      const note = pin.closest(".japan-map")?.querySelector<HTMLElement>("[data-map-note]");
      if (!note) return;
      note.hidden = false;
      note.textContent = `${pin.dataset.label} 숙소는 아직 준비 중이에요`;
    });
  });
</script>
