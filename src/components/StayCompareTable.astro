---
import type { CollectionEntry } from "astro:content";
import { partyList, stayPath, stayTransit } from "../lib/labels";
import { roomsForStay } from "../lib/rooms";

interface Props {
  stays: CollectionEntry<"stays">[];
}

const { stays } = Astro.props;
const rows = stays.flatMap((stay) =>
  roomsForStay(stay).map((room) => ({
    stay,
    room,
    parties: room.party_types?.length ? room.party_types : stay.data.party_types,
  })),
);
---

<div class="compare-wrap">
  <table class="compare">
    <thead>
      <tr>
        <th>숙소명</th>
        <th>침대 조합</th>
        <th>면적</th>
        <th>교통</th>
        <th>추천 조합</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map(({ stay, room, parties }) => (
          <tr data-parties={parties.join(" ")}>
            <td>
              <a href={stayPath(stay)}>{stay.data.nameKo}</a>
            </td>
            <td>{room.beds}</td>
            <td>{room.size_sqm ? `${room.size_sqm}㎡` : `${stay.data.room_size_sqm}㎡`}</td>
            <td>{stayTransit(stay)}</td>
            <td>{partyList(parties)}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
