---
import { bandWon } from "../lib/stayMeta";

interface Props {
  band: number;
  href: string;
  class?: string;
}

const { band, href, class: className } = Astro.props;
---

<a
  class:list={["price-ask", className]}
  href={href}
  rel="sponsored noopener noreferrer"
  target="_blank"
>
  <em>최저가 할인중!</em>
  <b>{bandWon(band)}</b>
</a>
