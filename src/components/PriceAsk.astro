---
import { affiliateHref } from "../lib/affiliate";
import { nightPrice } from "../lib/stayMeta";
import type { PriceBand } from "../lib/labels";

interface Props {
  band: PriceBand;
  href: string;
  class?: string;
}

const { band, href, class: className } = Astro.props;
---

<a
  class:list={["price-ask", className]}
  href={affiliateHref(href)}
  rel="sponsored noopener noreferrer"
  target="_blank"
>
  <b>{nightPrice(band)}</b>
  <em>직접 눌러서 확인!</em>
</a>
