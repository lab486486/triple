---
import type { CollectionEntry } from "astro:content";
import { cityCovers } from "../lib/covers";
import {
  cityNames,
  sleepLabels,
  stayPath,
  transitLabel,
  weekdayPriceLabels,
} from "../lib/labels";

interface Props {
  city: CollectionEntry<"cities">;
  stay: CollectionEntry<"stays">;
}

const { city, stay } = Astro.props;
const photo = cityCovers[city.id] ?? cityCovers.tokyo;
---

<a class="pkg-card city-pack" href={stayPath(stay)}>
  <div class="pkg-photo">
    <img src={photo} alt="" width="640" height="400" loading="lazy" />
    <span class="pkg-badge">{city.data.nameKo}</span>
  </div>
  <div class="pkg-body">
    <p class="pkg-kicker">{cityNames[city.id]} 대표숙소</p>
    <h3>{stay.data.nameKo}</h3>
    <ul class="pkg-facts">
      <li>숙소 구성 : {sleepLabels[stay.data.sleep_layout]}</li>
      <li>교통 : {transitLabel(stay.data.station, stay.data.walk_min)}</li>
      <li>가격 : {weekdayPriceLabels[stay.data.price_band]}</li>
    </ul>
  </div>
</a>
