---
import type { CollectionEntry } from "astro:content";
import { stayCover } from "../lib/covers";
import {
  cityNames,
  sleepLabels,
  stayPath,
  transitLabel,
  weekdayPriceLabels,
} from "../lib/labels";

interface Props {
  city: CollectionEntry<"cities">;
  stay: CollectionEntry<"stays">;
  picked?: boolean;
}

const { city, stay, picked = false } = Astro.props;
const photo = stayCover(stay.data.city, stay.data.area, stay.data.photos);
---

<a class:list={["pkg-card", "city-pack", picked && "is-pick"]} href={stayPath(stay)}>
  <div class="pkg-photo">
    <img src={photo} alt="" width="640" height="400" loading="lazy" />
    <span class="pkg-badge">{city.data.nameKo}</span>
  </div>
  <div class="pkg-body">
    <p class="pkg-kicker">{cityNames[city.id]} 추천 숙소</p>
    <h3>{stay.data.nameKo}</h3>
    <ul class="pkg-facts">
      <li>숙소 구성 : {sleepLabels[stay.data.sleep_layout]}</li>
      <li>교통 : {transitLabel(stay.data.station, stay.data.walk_min)}</li>
      <li>가격 : {weekdayPriceLabels[stay.data.price_band]}</li>
    </ul>
  </div>
</a>
