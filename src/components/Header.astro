---
import { nav } from "../site.config";

const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(href);
---

<header class="site-header">
  <div class="nav-shell">
    <a class="brand" href="/" aria-label="3인룸">
      <img class="brand-logo" src="/images/brand/logo-word.png" alt="3인룸" width="417" height="155" />
    </a>
    <nav class="nav-links" aria-label="주요 메뉴">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <button
      class="menu-btn"
      type="button"
      id="menu-btn"
      aria-expanded="false"
      aria-controls="mobile-panel"
      aria-label="메뉴 열기"
    >
      <span></span>
    </button>
  </div>
  <div class="container">
    <div class="mobile-panel" id="mobile-panel" data-open="false" hidden>
      {
        nav.map((item) => (
          <a class="mobile-link" href={item.href}>
            {item.label}
          </a>
        ))
      }
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById("menu-btn");
  const panel = document.getElementById("mobile-panel");
  if (btn && panel) {
    const toggle = () => {
      const open = panel.dataset.open !== "true";
      panel.dataset.open = String(open);
      panel.hidden = !open;
      btn.setAttribute("aria-expanded", String(open));
      btn.setAttribute("aria-label", open ? "메뉴 닫기" : "메뉴 열기");
    };
    btn.addEventListener("click", toggle);
    panel.querySelectorAll("a").forEach((link) =>
      link.addEventListener("click", () => {
        panel.dataset.open = "false";
        panel.hidden = true;
        btn.setAttribute("aria-expanded", "false");
        btn.setAttribute("aria-label", "메뉴 열기");
      }),
    );
  }
</script>
