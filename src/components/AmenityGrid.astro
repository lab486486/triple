---
import { amenityIcon, type AmenityIcon } from "../lib/amenities";

interface Props {
  items: string[];
  compact?: boolean;
}

const { items, compact = false } = Astro.props;

const paths: Record<AmenityIcon, string> = {
  wifi: "M2 8.5c3.2-3 6.8-4.5 10-4.5s6.8 1.5 10 4.5M5 12c2.2-2 4.6-3 7-3s4.8 1 7 3M8.5 15.2c1-.9 2.2-1.4 3.5-1.4s2.5.5 3.5 1.4M12 19h.01",
  bath: "M4 12h16v4a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3v-4Zm2-3V7a2 2 0 0 1 2-2h2",
  tv: "M4 7h16v10H4V7Zm4 13h8M12 17v3",
  ac: "M4 8h16v6H4V8Zm2 10h12M8 14v4m8-4v4",
  shower: "M8 4h8v3H8V4Zm4 3v3M7 14h10M8 18h8M9 10h6v4H9v-4Z",
  smoke: "M4 16h10M16 16h4M5 12h6m8-1c1.5 0 3-1.2 3-3",
  elevator: "M5 4h14v16H5V4Zm7 3v10m-3-7 3-3 3 3m-6 6 3 3 3-3",
  card: "M3 7h18v10H3V7Zm0 3h18",
  dryer: "M7 4h10l1 5H6L7 4Zm-1 5h12v11H6V9Zm6 4v4",
  pool: "M4 16c1.5 0 1.5-1 3-1s1.5 1 3 1 1.5-1 3-1 1.5 1 3 1 1.5-1 3-1M4 20c1.5 0 1.5-1 3-1s1.5 1 3 1 1.5-1 3-1 1.5 1 3 1 1.5-1 3-1M8 6h8v7H8V6Z",
  sauna: "M8 20V9l4-5 4 5v11M8 13h8",
  restaurant: "M8 3v10M6 3v6m4-6v6M16 4v16m-2-12h4",
  cafe: "M6 8h10v6a4 4 0 0 1-4 4H10a4 4 0 0 1-4-4V8Zm10 2h2a2 2 0 0 1 0 4h-2",
  parking: "M6 4h8a5 5 0 0 1 0 10H6V4Zm0 10v6",
  spa: "M12 4c-3 4-6 6-6 10a6 6 0 0 0 12 0c0-4-3-6-6-10Z",
  sprinkler: "M12 3v6m0 0 4-3M12 9 8 6m4 3 4 3M12 9 8 12M5 19h14",
};
---

<ul class:list={["amenity-grid", compact && "amenity-grid-compact"]}>
  {
    items.map((item) => {
      const icon = amenityIcon[item] ?? "wifi";
      return (
        <li>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path
              d={paths[icon]}
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          <span>{item}</span>
        </li>
      );
    })
  }
</ul>
