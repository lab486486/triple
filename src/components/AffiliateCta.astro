---
import { affiliateHref } from "../lib/affiliate";

interface Props {
  href: string;
  label?: string;
  class?: string;
}

const { href, label = "라쿠텐트래블에서 일정·잔여 확인", class: className } = Astro.props;
---

<a
  class:list={["cta", className]}
  href={affiliateHref(href)}
  rel="sponsored noopener noreferrer"
  target="_blank"
>
  {label}
</a>
