---
import Layout from "../layouts/Layout.astro";
---

<Layout title="페이지를 찾을 수 없습니다" description="요청하신 주소가 없습니다.">
  <main id="main">
    <div class="container not-found">
      <p class="kicker">404</p>
      <h1>이 주소에는 숙소가 없습니다</h1>
      <p class="lede">페이지가 없거나 옮겨졌습니다. 지역 목록에서 다시 골라 보세요.</p>
      <p class="cta-row">
        <a class="cta" href="/">홈으로</a>
        <a class="cta cta-ghost" href="/tokyo/ueno/">우에노 숙소 3인</a>
      </p>
    </div>
  </main>
</Layout>
