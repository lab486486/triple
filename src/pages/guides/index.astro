---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const guides = (await getCollection("guides")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<Layout
  title="일본 3인 숙소 고르는 법"
  description="트리플베드, 엑스트라베드, 화실, 아파트형. 3명이 실제로 눕는 방을 고르는 기준입니다."
>
  <main id="main" class="section">
    <div class="container">
      <p class="kicker">가이드</p>
      <h1>일본 숙소 3인, 고르는 법</h1>
      <p class="lede">검색 결과의 「3인 가능」을 그대로 믿지 않기 위한 짧은 글입니다.</p>
      <div class="grid grid-2" style="margin-top:2rem">
        {
          guides.map((guide) => (
            <a class="card" href={`/guides/${guide.id}/`}>
              <p class="kicker">{guide.data.kicker}</p>
              <h3>{guide.data.title}</h3>
              <p>{guide.data.description}</p>
            </a>
          ))
        }
      </div>
    </div>
  </main>
</Layout>
