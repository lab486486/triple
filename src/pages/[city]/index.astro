---
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import StayCard from "../../components/StayCard.astro";
import FaqList from "../../components/FaqList.astro";
import { getCities, getStaysByCity, getCity } from "../../lib/content";
import { breadcrumbJsonLd, crumbsForCity, faqJsonLd } from "../../lib/jsonld";
import { render } from "astro:content";

export async function getStaticPaths() {
  const cities = await getCities();
  return cities.map((city) => ({
    params: { city: city.id },
    props: { cityId: city.id },
  }));
}

const { cityId } = Astro.props;
const city = await getCity(cityId);
if (!city) throw new Error(`Unknown city: ${cityId}`);
const stays = await getStaysByCity(city.id);
const { Content } = await render(city);
const crumbs = crumbsForCity(city);
const ledeLines = city.data.lede.split(/(?<=\.)\s+/).filter(Boolean);
---

<Layout
  title={city.data.title}
  description={city.data.description}
  jsonLd={[breadcrumbJsonLd(crumbs), faqJsonLd(city.data.faqs)]}
>
  <main id="main">
    <section class="page-hero">
      <div class="container">
        <Breadcrumb items={crumbs} />
        <p class="kicker">{city.data.kicker}</p>
        <h1>{city.data.title}</h1>
        <p class="lede lede-lines">
          {ledeLines.map((line) => <span>{line}</span>)}
        </p>
      </div>
    </section>
    <section class="section">
      <div class="container">
        <h2>{city.data.nameKo} 3인실 숙소 리스트</h2>
        <div class="grid grid-3" style="margin-top:1rem">
          {stays.slice(0, 6).map((stay) => <StayCard stay={stay} />)}
        </div>
      </div>
    </section>
    <section class="section">
      <article class="narrow prose">
        <Content />
      </article>
    </section>
    <div class="container">
      <FaqList faqs={city.data.faqs} />
    </div>
  </main>
</Layout>
