---
import { getCollection, render } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import AffiliateCta from "../../../components/AffiliateCta.astro";
import AmenityGrid from "../../../components/AmenityGrid.astro";
import PriceAsk from "../../../components/PriceAsk.astro";
import StayCard from "../../../components/StayCard.astro";
import StayGallery from "../../../components/StayGallery.astro";
import StayRoomCard from "../../../components/StayRoomCard.astro";
import { getArea, getCity, relatedStays } from "../../../lib/content";
import { stayCover, stayGallery } from "../../../lib/covers";
import { stayAffiliateUrl } from "../../../lib/affiliate";
import { roomsForStay } from "../../../lib/rooms";
import { mapsHref, stayScore } from "../../../lib/stayMeta";
import { placeLabel, stayTransit } from "../../../lib/labels";
import {
  breadcrumbJsonLd,
  crumbsForStay,
  lodgingJsonLd,
} from "../../../lib/jsonld";

export async function getStaticPaths() {
  const stays = await getCollection("stays");
  return stays.map((stay) => ({
    params: {
      city: stay.data.city,
      area: stay.data.area,
      stay: stay.id,
    },
    props: { stay },
  }));
}

const { stay } = Astro.props;
const city = await getCity(stay.data.city);
const area = await getArea(stay.data.city, stay.data.area);
if (!city || !area) throw new Error(`Missing parent for ${stay.id}`);
const { Content } = await render(stay);
const related = await relatedStays(stay);
const crumbs = crumbsForStay(city, area, stay);
const photos = stayGallery(stay.data.city, stay.data.area, stay.data.photos);
const rooms = roomsForStay(stay);
const cover = stayCover(stay.data.city, stay.data.area, stay.data.photos);
const place = placeLabel(stay.data.city, stay.data.area);
const { score, count } = stayScore(stay.id);
const amenities = stay.data.amenities;
const mapUrl = mapsHref(stay.data.address);
const bookUrl = stayAffiliateUrl(stay);
---

<Layout
  title={`${stay.data.nameKo} 3인`}
  description={stay.data.verdict}
  jsonLd={[breadcrumbJsonLd(crumbs), lodgingJsonLd(stay)]}
>
  <main id="main" class="stay-page">
    <section class="stay-top">
      <div class="container">
        <Breadcrumb items={crumbs} />
        <StayGallery photos={photos} name={stay.data.nameKo} />
        <div class="stay-title">
          <div>
            <p class="kicker">{place}</p>
            <h1>{stay.data.nameKo}</h1>
          </div>
          <PriceAsk band={stay.data.price_band} href={bookUrl} />
        </div>
        <div class="stay-panels">
          <a class="stay-panel" href="#intro">
            <p class="stay-score">
              <span aria-hidden="true">★</span>
              <b>{score}</b>
              <em>{count}명 평가 ›</em>
            </p>
            <p class="stay-panel-copy">{stay.data.verdict}</p>
          </a>
          <a class="stay-panel" href="#intro">
            <p class="stay-panel-head">서비스 및 부대시설 <span>›</span></p>
            <AmenityGrid items={amenities.slice(0, 6)} compact />
          </a>
          <a
            class="stay-panel stay-panel-map"
            href={mapUrl}
            rel="noopener noreferrer"
            target="_blank"
          >
            <div class="stay-map-copy">
              <p class="stay-panel-head">위치 정보 <span>›</span></p>
              <p class="stay-map-line">
                {stay.data.address}
                <span>지도보기</span>
              </p>
              <p class="stay-map-walk">{stayTransit(stay)}</p>
            </div>
            <div class="stay-map-visual" aria-hidden="true"></div>
          </a>
        </div>
      </div>
    </section>

    <nav class="stay-tabs" aria-label="숙소 섹션">
      <div class="container stay-tabs-row">
        <a href="#rooms">객실 정보</a>
        <a href="#intro">숙소 소개</a>
        <a href="#location">위치 정보</a>
      </div>
    </nav>

    <section class="section" id="rooms">
      <div class="container">
        <h2>객실 정보</h2>
        <p class="section-note">링크를 통해 구매가 이루어지면 소정의 수수료를 지급받습니다</p>
        <div class="room-list">
          {rooms.map((room) => <StayRoomCard room={room} stay={stay} photo={cover} />)}
        </div>
      </div>
    </section>

    <section class="section" id="intro">
      <article class="container stay-intro">
        <h2>숙소 소개</h2>
        <div class="prose">
          <Content />
        </div>
        <hr class="stay-rule" />
        <h2>서비스 및 부대시설</h2>
        <AmenityGrid items={amenities} />
      </article>
    </section>

    <section class="section" id="location">
      <div class="container">
        <h2>위치 정보</h2>
        <a
          class="stay-panel stay-panel-map stay-panel-wide"
          href={mapUrl}
          rel="noopener noreferrer"
          target="_blank"
        >
          <div class="stay-map-copy">
            <p class="stay-map-line">
              {stay.data.address}
              <span>지도보기</span>
            </p>
            <p class="stay-map-walk">{stayTransit(stay)}</p>
          </div>
          <div class="stay-map-visual" aria-hidden="true"></div>
        </a>
      </div>
    </section>

    {
      related.length > 0 && (
        <section class="section">
          <div class="container">
            <h2>같은 지역에서</h2>
            <div class="grid grid-3" style="margin-top:1rem">
              {related.map((item) => (
                <StayCard stay={item} />
              ))}
            </div>
          </div>
        </section>
      )
    }

    <div class="stay-dock">
      <div class="container stay-dock-row">
        <AffiliateCta href={bookUrl} class="stay-dock-cta" label="객실 예약하기" />
      </div>
    </div>
  </main>
</Layout>
