---
import { getCollection, render } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import AffiliateCta from "../../../components/AffiliateCta.astro";
import StayCard from "../../../components/StayCard.astro";
import StayGallery from "../../../components/StayGallery.astro";
import StayRoomCard from "../../../components/StayRoomCard.astro";
import { getArea, getCity, relatedStays } from "../../../lib/content";
import { stayCover, stayGallery } from "../../../lib/covers";
import { roomsForStay, stayFacts } from "../../../lib/rooms";
import { placeLabel, priceLabels } from "../../../lib/labels";
import {
  breadcrumbJsonLd,
  crumbsForStay,
  lodgingJsonLd,
} from "../../../lib/jsonld";

export async function getStaticPaths() {
  const stays = await getCollection("stays");
  return stays.map((stay) => ({
    params: {
      city: stay.data.city,
      area: stay.data.area,
      stay: stay.id,
    },
    props: { stay },
  }));
}

const { stay } = Astro.props;
const city = await getCity(stay.data.city);
const area = await getArea(stay.data.city, stay.data.area);
if (!city || !area) throw new Error(`Missing parent for ${stay.id}`);
const { Content } = await render(stay);
const related = await relatedStays(stay);
const crumbs = crumbsForStay(city, area, stay);
const photos = stayGallery(stay.data.city, stay.data.area, stay.data.photos);
const rooms = roomsForStay(stay);
const facts = stayFacts(stay);
const cover = stayCover(stay.data.city, stay.data.area);
const place = placeLabel(stay.data.city, stay.data.area);
---

<Layout
  title={`${stay.data.nameKo} 3인`}
  description={stay.data.verdict}
  jsonLd={[breadcrumbJsonLd(crumbs), lodgingJsonLd(stay)]}
>
  <main id="main" class="stay-page">
    <section class="stay-top">
      <div class="container">
        <Breadcrumb items={crumbs} />
        <StayGallery photos={photos} name={stay.data.nameKo} />
        <div class="stay-head">
          <div>
            <p class="kicker">{place}</p>
            <h1>{stay.data.nameKo}</h1>
            <p class="lede">{stay.data.verdict}</p>
            <ul class="stay-facts">
              {facts.map((fact) => <li>{fact}</li>)}
            </ul>
          </div>
          <aside class="stay-head-card">
            <span class="pkg-from">경비 띠</span>
            <b>{priceLabels[stay.data.price_band]}</b>
            <p>{stay.data.station} 도보 {stay.data.walk_min}분</p>
            <AffiliateCta href={stay.data.rakuten_url} />
            {
              stay.data.official_url && (
                <a
                  class="cta cta-ghost"
                  href={stay.data.official_url}
                  rel="noopener noreferrer"
                  target="_blank"
                >
                  공식 사이트
                </a>
              )
            }
          </aside>
        </div>
      </div>
    </section>

    <nav class="stay-tabs" aria-label="숙소 섹션">
      <div class="container stay-tabs-row">
        <a href="#rooms">3인실 선택</a>
        <a href="#intro">숙소 소개</a>
        <a href="#location">위치</a>
      </div>
    </nav>

    <section class="section" id="rooms">
      <div class="container">
        <h2>3인실만 고릅니다</h2>
        <p class="section-note">트윈·스탠다드는 올리지 않습니다. 예약은 라쿠텐에서 날짜를 넣어 확인하세요.</p>
        <div class="room-list">
          {rooms.map((room) => <StayRoomCard room={room} stay={stay} photo={cover} />)}
        </div>
      </div>
    </section>

    <section class="section" id="intro">
      <article class="container stay-intro">
        <h2>숙소 소개</h2>
        <div class="callout">
          <strong>맞지 않는 사람</strong>
          {stay.data.not_for}
        </div>
        <div class="prose">
          <Content />
        </div>
      </article>
    </section>

    <section class="section" id="location">
      <div class="container stay-location">
        <div>
          <h2>위치</h2>
          <p class="lede">{stay.data.address}</p>
          <p>{stay.data.station}에서 도보 {stay.data.walk_min}분. {place} 권역입니다.</p>
        </div>
        <div class="stay-location-card">
          <strong>{stay.data.station}</strong>
          <span>도보 {stay.data.walk_min}분</span>
          <p>{stay.data.address}</p>
        </div>
      </div>
    </section>

    {
      related.length > 0 && (
        <section class="section">
          <div class="container">
            <h2>같은 지역에서</h2>
            <div class="grid grid-3" style="margin-top:1rem">
              {related.map((item) => (
                <StayCard stay={item} />
              ))}
            </div>
          </div>
        </section>
      )
    }

    <div class="stay-dock">
      <div class="container stay-dock-row">
        <div>
          <small>{stay.data.nameKo}</small>
          <b>{priceLabels[stay.data.price_band]} · {stay.data.station} {stay.data.walk_min}분</b>
        </div>
        <AffiliateCta href={stay.data.rakuten_url} class="stay-dock-cta" />
      </div>
    </div>
  </main>
</Layout>
