---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { areaCover } from "../../lib/covers";

const posts = (await getCollection("guides")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<Layout
  title="블로그"
  description="일본 3인 숙소를 고르는 기준과 여행 메모를 모았습니다."
>
  <main id="main" class="section">
    <div class="container">
      <p class="kicker">블로그</p>
      <h1>일본 3인 숙소 이야기</h1>
      <p class="lede">방을 고르는 기준과, 다녀온 뒤에 남는 메모입니다.</p>
      <div class="article-grid" style="margin-top:2rem">
        {
          posts.map((post) => (
            <a class="article-card" href={`/blog/${post.id}/`}>
              <img
                src={post.data.cover_image || areaCover("tokyo", "ueno")}
                alt=""
                width="640"
                height="360"
                loading="lazy"
              />
              <div>
                <small>{post.data.kicker}</small>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </main>
</Layout>
