---
import Layout from "../layouts/Layout.astro";
import SearchBar from "../components/SearchBar.astro";
import StayCard from "../components/StayCard.astro";
import { getCollection } from "astro:content";

const stays = (await getCollection("stays")).sort(
  (a, b) => a.data.rank - b.data.rank,
);
---

<Layout
  title="숙소 찾기"
  description="지역과 침대 구성으로 일본 3인 숙소를 가릅니다."
>
  <main id="main">
    <section class="search-band">
      <div class="container">
        <p class="search-kicker">검색</p>
        <h1>조건에 맞는 3인 숙소</h1>
        <SearchBar layout="page" />
      </div>
    </section>
    <section class="section">
      <div class="container">
        <p class="result-count" id="result-count">{stays.length}곳</p>
        <p class="lede" id="empty-msg" hidden>조건에 맞는 숙소가 없습니다. 지역만 고르거나 침대 구성을 비워 보세요.</p>
        <div class="pack-grid" id="result-grid">
          {stays.map((stay) => <StayCard stay={stay} />)}
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  const params = new URLSearchParams(window.location.search);
  const region = params.get("region") ?? "";
  const layout = params.get("layout") ?? "";
  const cards = document.querySelectorAll<HTMLElement>("#result-grid .pkg-card");
  let shown = 0;
  cards.forEach((card) => {
    const city = card.dataset.city ?? "";
    const area = card.dataset.area ?? "";
    const matchRegion =
      !region || region === city || region === area;
    const matchLayout = !layout || card.dataset.layout === layout;
    const show = matchRegion && matchLayout;
    card.style.display = show ? "" : "none";
    if (show) shown += 1;
  });
  const count = document.getElementById("result-count");
  const empty = document.getElementById("empty-msg");
  if (count) count.textContent = `${shown}곳`;
  if (empty) empty.hidden = shown !== 0;
</script>
