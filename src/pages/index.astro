---
import Layout from "../layouts/Layout.astro";
import SearchBar from "../components/SearchBar.astro";
import CityPackageCard from "../components/CityPackageCard.astro";
import { organizationJsonLd } from "../lib/jsonld";
import { getAreasByCity, getCities, getCityHighlights } from "../lib/content";
import { areaCover } from "../lib/covers";
import { areaPath } from "../lib/labels";

const cities = await getCities();
const highlights = await getCityHighlights();
const areaEntries = await Promise.all(
  cities.map(async (city) => ({
    city,
    areas: await getAreasByCity(city.id),
  })),
);
const destinations = areaEntries.flatMap(({ city, areas }) =>
  areas.map((area) => ({ city, area })),
);
---

<Layout jsonLd={organizationJsonLd()}>
  <main id="main">
    <section class="search-band">
      <div class="container intro-search">
        <div class="intro-copy">
          <p class="search-kicker">일본 3인 숙소만</p>
          <h1>3명이 눕는 방만 올립니다</h1>
          <p class="lede">
            정원 숫자 대신 누가 어디에 눕는지를 봅니다. 소파베드와 협소한 엑베는
            비추천으로 밝히고, 예약은 라쿠텐트래블에서 확인합니다.
          </p>
          <ul class="feature-list">
            <li>
              <strong>수면 구성</strong>
              트리플베드, 아파트형, 화실, 엑베를 같은 기준으로 가릅니다.
            </li>
            <li>
              <strong>교차확인</strong>
              공식 사이트의 면적과 침대 수를 맞춰 본 숙소만 올립니다.
            </li>
            <li>
              <strong>동행을 나눔</strong>
              부부+자녀와 성인 3인은 다른 방입니다.
            </li>
          </ul>
        </div>
        <SearchBar />
      </div>
    </section>

    <section class="section" id="featured">
      <div class="container">
        <div class="section-head">
          <h2>도시별 추천 숙소</h2>
          <a class="text-link" href="/tokyo/">도쿄부터 보기</a>
        </div>
        <div class="city-grid">
          {
            highlights.map(({ city, stay }) => (
              <CityPackageCard city={city} stay={stay} />
            ))
          }
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-head">
          <h2>여행 지역</h2>
          <a class="text-link" href="/tokyo/ueno/">우에노부터 보기</a>
        </div>
        <div class="dest-grid">
          {
            destinations.map(({ city, area }) => (
              <a class="dest-card" href={areaPath(city.id, area.data.slug)}>
                <img
                  src={areaCover(city.id, area.data.slug)}
                  alt=""
                  width="640"
                  height="420"
                  loading="lazy"
                />
                <span>
                  <small>{city.data.nameKo}</small>
                  <strong>{area.data.nameKo}</strong>
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-head">
          <h2>고르는 법</h2>
          <a class="text-link" href="/guides/">모든 가이드</a>
        </div>
        <div class="article-grid">
          <a class="article-card" href="/guides/how-to-choose-3-person-stay/">
            <img src={areaCover("tokyo", "ueno")} alt="" width="640" height="360" loading="lazy" />
            <div>
              <small>가이드</small>
              <h3>일본 숙소 3인, 이렇게 고르면 됩니다</h3>
              <p>트리플베드, 엑스트라베드, 화실, 아파트형을 한 기준으로 가릅니다.</p>
            </div>
          </a>
          <a class="article-card" href="/guides/couple-child-vs-three-adults/">
            <img src={areaCover("osaka", "namba")} alt="" width="640" height="360" loading="lazy" />
            <div>
              <small>가이드</small>
              <h3>부부+자녀와 성인 3인은 다른 방입니다</h3>
              <p>첨이네가 통하는 구성과, 어른 세 명이 각자 눕는 구성.</p>
            </div>
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
