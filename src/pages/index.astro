---
import Layout from "../layouts/Layout.astro";
import SearchBar from "../components/SearchBar.astro";
import CityPackageCard from "../components/CityPackageCard.astro";
import { organizationJsonLd } from "../lib/jsonld";
import { getAreasByCity, getCities, getCityHighlights } from "../lib/content";
import { areaCover } from "../lib/covers";
import { areaPath } from "../lib/labels";
import { getCollection } from "astro:content";

const cities = await getCities();
const highlights = await getCityHighlights();
const areaEntries = await Promise.all(
  cities.map(async (city) => ({
    city,
    areas: await getAreasByCity(city.id),
  })),
);
const destinations = areaEntries.flatMap(({ city, areas }) =>
  areas.map((area) => ({ city, area })),
);
const posts = (await getCollection("guides"))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 2);
---

<Layout jsonLd={organizationJsonLd()}>
  <main id="main">
    <section class="search-band">
      <div class="container intro-search">
        <div class="intro-copy">
          <div class="intro-visual">
            <img
              src="/images/covers/family-stay-tokyo.png"
              alt="도쿄타워가 보이는 호텔에서, 나란히 놓은 더블·싱글 침대에 쉬는 3인 가족"
              width="1200"
              height="900"
            />
            <div class="intro-text">
              <p class="search-kicker">일본여행 정보</p>
              <h1>트리플 : 3인 숙소정보 플랫폼</h1>
              <p class="lede lede-lines">
                <span>애매한 3인 여행자를 위한 완벽한 숙소 가이드!</span>
                <span>누구 하나 소외없이 만족스러운 여행을 만들어드립니다.</span>
              </p>
            </div>
          </div>
        </div>
        <SearchBar />
      </div>
    </section>

    <section class="section" id="featured">
      <div class="container">
        <div class="section-head">
          <h2>도시별 추천 숙소</h2>
          <a class="text-link" href="/search/">전체보기</a>
        </div>
        <div class="city-grid">
          {
            highlights.map(({ city, stay }) => (
              <CityPackageCard city={city} stay={stay} />
            ))
          }
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-head">
          <h2>도시별 주요 베이스캠프</h2>
        </div>
        <div class="dest-grid">
          {
            destinations.map(({ city, area }) => (
              <a class="dest-card" href={areaPath(city.id, area.data.slug)}>
                <img
                  src={areaCover(city.id, area.data.slug)}
                  alt=""
                  width="640"
                  height="420"
                  loading="lazy"
                />
                <span>
                  <strong>{city.data.nameKo} {area.data.nameKo}</strong>
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-head">
          <h2>블로그</h2>
          <a class="text-link" href="/blog/">전체 글 보기</a>
        </div>
        <div class="article-grid">
          {
            posts.map((post) => (
              <a class="article-card" href={`/blog/${post.id}/`}>
                <img
                  src={post.data.cover_image || areaCover("tokyo", "ueno")}
                  alt=""
                  width="640"
                  height="360"
                  loading="lazy"
                />
                <div>
                  <small>{post.data.kicker}</small>
                  <h3>{post.data.title}</h3>
                  <p>{post.data.description}</p>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</Layout>
